# Copiá este archivo a .env y completá con los valores reales de tu proyecto Supabase.
# Nunca subas el archivo .env real a git (ya está en .gitignore).

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU-ANON-KEY

# Solo servidor. Secreto de administrador de Supabase (Project Settings > API Keys > service_role).
SUPABASE_SERVICE_KEY=
