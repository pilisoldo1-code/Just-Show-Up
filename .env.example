# Copiá este archivo a .env y completá con los valores reales de tu proyecto Supabase.
# Nunca subas el archivo .env real a git (ya está en .gitignore).

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_KEY=TU-ANON-KEY

# Solo servidor. Secreto de administrador de Supabase (Project Settings > API Keys > service_role).
SUPABASE_SERVICE_KEY=

# Videos On Demand. Proyecto de Supabase aparte para los archivos (opcional: sin estas dos se usa el proyecto
# principal). Separarlo evita que un exceso de transferencia de video bloquee toda la app.
VIDEOS_SUPABASE_URL=
VIDEOS_SUPABASE_SERVICE_KEY=
# Lo manda Vercel a la limpieza diaria (Authorization: Bearer ...). Sin esto la limpieza no corre.
CRON_SECRET=
# Entorno de Videos On Demand: tiene que coincidir con el programa local y con video_parametros.entorno.
# Vacío = el servidor rechaza al programa local. El valor de pruebas lo genera scripts/videos_prueba_datos.py.
VIDEOS_ENTORNO=
